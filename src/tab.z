~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */






// ---------------- BASICS ----------------

//existence
pub fct tab.init(smax itmSz, smax lenMax) {
	sbj.len    = 0
	sbj.itmSz  = itmSz
	sbj.lenMax = lenMax

	//no lazy alloc
	if itmSz != 0 { sbj.dat = ^Heap.new(itmSz * lenMax) }
}
pub fct tab.free() {
	^Heap.free(sbj.dat)
}



//unsafe indexing
#CFG  TAB__UNSAFE_ACCESS { pub \}
#!CFG TAB__UNSAFE_ACCESS { prv \}
fct tab[dcn].unsafe_get(smax idx) dcn0 {
	dcn0 res
	#CFG  TAB__HEAP_SAFE { ^Heap.safe_w(  sbj.dat, idx*sbj.itmSz, @res, 0, sbj.itmSz) }
	#!CFG TAB__HEAP_SAFE { ^Heap.unsafe_w(sbj.dat, idx*sbj.itmSz, @res, 0, sbj.itmSz) }
	ret res
}

#CFG  TAB__UNSAFE_ACCESS { pub \}
#!CFG TAB__UNSAFE_ACCESS { prv \}
fct tab[dcn].unsafe_set(smax idx, dcn0 elm) {
	#CFG  TAB__HEAP_SAFE { ^Heap.safe_w(  @elm, 0, sbj.dat, idx*sbj.itmSz, sbj.itmSz) }
	#!CFG TAB__HEAP_SAFE { ^Heap.unsafe_w(@elm, 0, sbj.dat, idx*sbj.itmSz, sbj.itmSz) }
}



//safe indexing
pub fct tab[dcn].safe_get(smax idx) dcn0 {
	if idx >= sbj.len { #{lle_oob} ret }
	#{lle_scc}
	ret sbj.unsafe_get(idx)
}
pub fct tab[dcn].safe_set(smax idx, dcn0 elm) {
	if(idx >= sbj.len){ #{lle_oob} ret }
	#{lle_scc}
	sbj.unsafe_set(idx, elm)
}



//last
pub fct tab.isEmpty() bol {
	ret sbj.len == 0
}
pub fct tab[dcn].last() dcn0 {
	ret sbj.safe_get(sbj.len-1, dst, offset)
}
pub fct tab.rmLast() {
	//sbj.len -= 1 <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
	sbj.len = sbj.len - 1
}
pub fct tab[dcn].popLast() {
	res = sbj.last()
	sbj.rmLast()
	ret res
}



//push
#CFG  TAB__UNSAFE_ACCESS { pub \}
#!CFG TAB__UNSAFE_ACCESS { prv \}
fct tab[dcn].unsafe_push(dcn0 elm) {
	sbj.unsafe_set(sbj.len, elm)
	//sbj.len += 1 <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
	sbj.len = sbj.len + 1
}

pub fct tab[dcn].safe_push(dcn0 elm) {
	if sbj.len >= sbj.lenMax { #{lle_oob} ret }
	#{lle_scc}
	sbj.unsafe_push(elm)
}



//actions as a whole
pub fct tab.empty() {
	sbj.len = 0
}
pub fct tab[dcn].overwrite(dcn0 elm) {
	for i in sbj { sbj.unsafe_set(i, elm) }
}
pub fct tab[dcn].fullfill(dcn0 elm) {
	sbj.len = sbj.lenMax
	sbj.overwrite(elm)
}



//actions between tabs
pub fct tab[dcn].copy(tab[dcn0] dst) {
	//if sbj.itmSz != dst.itmSz  { #{lle_fai} ret } //<<<<<<<<<<<<<<<<<<<<<< SHOULD NOT BE REQUIRED BECAUSE PARAM HAS SAME DECLINATION
	if sbj.len   >  dst.lenMax { #{lle_oob} ret }
	#{lle_scc}

	//don't care about what was in dst, just write in it
	dst.len = 0 //<=> dst.empty()
	for i in sbj {
		dst.unsafe_push(sbj.unsafe_get(i))
	}
}
